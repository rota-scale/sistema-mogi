# Copie para .env (make env faz isso e gera valores aleatórios locais).
# Só valores locais aqui. Chaves reais (IA, Jev) nunca entram no Git.

# Postgres
POSTGRES_DB=mogi
POSTGRES_USER=mogi
POSTGRES_PASSWORD=troque-local
POSTGRES_PORTA=5433

# SeaweedFS (API S3). A mídia só sai pelo Go, em link assinado.
S3_ACCESS_KEY=troque-local
S3_SECRET_KEY=troque-local
S3_BUCKET=mogi-midia
S3_ENDPOINT=localhost:8333

# Backend Go
API_ENDERECO=0.0.0.0:8080
# Porta publicada pelo Docker (make subir).
API_PORTA=8080
# Segredo do JWT e dos links de mídia, 32 caracteres ou mais (make env gera).
JWT_SEGREDO=
# Chave que cifra o CPF e o CNPJ do morador e gera o HMAC que acha o
# cadastro (ADR 0024), 32 caracteres ou mais (make env gera). Vazia, sai do
# JWT_SEGREDO. Não troque depois de ter cadastros: os documentos já gravados
# deixam de abrir e o mesmo CPF vira um cadastro novo.
DOCUMENTO_CHAVE=
# Usuários iniciais do painel. Sem senha, o usuário não é criado.
SEED_LOGIN=gestor
SEED_SENHA=
OPERADOR_LOGIN=operador
OPERADOR_SENHA=
# Equipe de campo: vê e resolve só os chamados da secretaria dela. O gestor
# cria as outras equipes no painel (Regras, aba Usuários). Valor com espaço
# precisa de aspas.
CAMPO_LOGIN=equipe
CAMPO_SENHA=
CAMPO_SECRETARIA="Obras e vias"
# Conta do prefeito: abre o Gabinete, só leitura. Sem senha, não é criada.
# PREFEITO_NOME é como o painel o chama, por exemplo "Prefeito Fulano".
PREFEITO_LOGIN=prefeito
PREFEITO_SENHA=
PREFEITO_NOME=
# Geocodificação reversa (RF02). Servidor público: 1 req/s e cache no banco.
# Deixe vazio para desligar, ou aponte para uma instância própria.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Busca do CEP no cadastro (ViaCEP). Vazia desliga; sem a linha, usa o ViaCEP.
CEP_URL=https://viacep.com.br/ws
# Alertas do vigia (banco ou fotos fora, triagem parada, muitos erros): além
# do log e da aba Operação, manda para um webhook. Ex.: https://ntfy.sh/<seu-topico>
# (app ntfy no celular), um webhook do Slack ou do Discord. Vazio desliga.
ALERTA_URL=
CIDADE=itamogi
# Nome mostrado no app do morador.
CIDADE_NOME=Itamogi-MG
# Cerca do município: minLng,minLat,maxLng,maxLat. Com ela, relato de fora da
# cidade é recusado. Vazia aceita de qualquer lugar (teste longe de Itamogi).
# Caixa aproximada de Itamogi, a confirmar com o limite oficial do IBGE:
CIDADE_CAIXA=-47.20,-21.22,-46.90,-20.95
# Centro da cidade (lat,lng): onde o mapa abre. Só vale ao criar uma cidade nova.
CIDADE_CENTRO=-21.0793,-47.0486
# true só quando o servidor está atrás de túnel ou proxy reverso (make tunel
# liga sozinho). Aí o IP de quem chama vem no cabeçalho do proxy.
PROXY_CONFIAVEL=false

# Jev da TypeSafe (ADR 0007): decide categoria, sinais de risco e G, U e T.
# Vai na frente da cadeia. Cole a chave só no .env.
TYPESAFE_API_KEY=
JEV_MODELO=jev-latest
# Manda a foto já borrada ao Jev (liberado pelo Russo em 12/11/2026).
# false volta a mandar só o texto.
JEV_FOTO=true

# Visão com IA (RF04): descreve a foto borrada e serve de reserva do Jev.
# Sem nenhuma chave, roda só o classificador local por categoria e palavras.
IA_CHAVE=
IA_MODELO=claude-opus-5-5
# Confere se a foto do morador é de lugar público, antes de gravar. Modelo
# rápido: o morador espera a resposta.
IA_MODELO_CENA=claude-haiku-5-5
# Reais por dólar, usado no log de custo (RF11). A confirmar no dia.
CAMBIO_USD_BRL=5.5

# Borrão das fotos (RF03): seletivo (rostos e placas) ou total (foto inteira).
BORRADOR=seletivo

# Mídia do relato (ADR 0015). Vídeo curto, sem áudio, de até 15 s. false
# trava o vídeo desligado nesta instalação, mesmo que o gestor ligue o módulo.
MODULO_VIDEO=true
# O que mais o gestor ajusta sem reiniciar (raio do agrupamento, limites de
# envio, dias de guarda da mídia original, módulos) fica no painel, em
# Regras, aba Parâmetros (ADR 0018).

# Formato do log do servidor: texto (padrão, bom para ler no terminal) ou
# json (uma linha por evento, para um coletor de logs).
LOG_FORMATO=texto

# Chamados simulados criados quando o banco está vazio. 0 desliga.
DEMO_CHAMADOS=0
