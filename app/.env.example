# Copie para app/.env (o "make app" faz isso sozinho).
# Endereço do servidor MOGI visto pelo celular, sem barra no fim.
# Pode ser o link https do túnel (make tunel) ou http://IP-do-computador:8080
# quando o celular está na mesma Wi-Fi. O app chama as rotas em /api.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
